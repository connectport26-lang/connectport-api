generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  individual
  business
}

enum SourceType {
  link
  photo
  text
}

enum Flexibility {
  exact
  flexible
}

enum BudgetScope {
  per_unit
  total
}

enum NeedByKind {
  specific_date
  timeframe
  flexible
}

enum RequestReferenceKind {
  link
  image
}

enum RequestStatus {
  submitted
  quoted
  approved_paid
  procured
  in_transit_china_warehouse
  in_transit_freight
  arrived_nigeria_warehouse
  delivered
}

enum QuoteStatus {
  sent
  accepted
  rejected
}

enum PaymentStatus {
  unpaid
  paid
  failed
}

enum PaymentGateway {
  paystack
  flutterwave
}

enum NotificationChannel {
  whatsapp
  sms
  email
}

enum OpsRole {
  admin
  agent
}

enum CredentialKind {
  requester
  ops
}

enum ProductStatus {
  draft
  verified
  published
  archived
}

enum ProductAvailability {
  in_stock
  made_to_order
  limited
}

model User {
  id          String      @id @default(cuid())
  name        String
  email       String      @unique
  phone       String
  accountType AccountType
  createdAt   DateTime    @default(now())
  credential  Credential?
  requests    Request[]
}

model OpsUser {
  id               String       @id @default(cuid())
  name             String
  email            String       @unique
  role             OpsRole
  credential       Credential?
  assignedRequests Request[]
  quotes           Quote[]
  teamMemberships  TeamMember[]
}

model Team {
  id        String       @id @default(cuid())
  name      String
  createdAt DateTime     @default(now())
  members   TeamMember[]
  requests  Request[]
}

model TeamMember {
  id        String  @id @default(cuid())
  teamId    String
  opsUserId String
  team      Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  opsUser   OpsUser @relation(fields: [opsUserId], references: [id], onDelete: Cascade)

  @@unique([teamId, opsUserId])
  @@index([opsUserId])
}

model Credential {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  kind         CredentialKind
  tokenVersion Int            @default(0)
  disabled     Boolean        @default(false)
  userId       String?        @unique
  opsUserId    String?        @unique
  user         User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  opsUser      OpsUser?       @relation(fields: [opsUserId], references: [id], onDelete: Cascade)
}

model EmailOtp {
  id           String   @id @default(cuid())
  email        String
  purpose      String
  codeHash     String
  payloadJson  String   @db.Text
  attempts     Int      @default(0)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
}

model Request {
  id                  String            @id @default(cuid())
  reference           String            @unique
  userId              String
  sourceType          SourceType
  sourceValue         String            @db.Text
  quantity            Int
  budgetMax           Decimal           @db.Decimal(14, 2)
  timeline            String
  qualityNotes        String            @db.Text
  flexibility         Flexibility
  productName         String?
  productDescription  String?           @db.Text
  budgetScope         BudgetScope?
  needByKind          NeedByKind?
  needByDate          DateTime?
  needByTimeframe     String?
  status              RequestStatus     @default(submitted)
  assignedOpsUserId   String?
  teamId              String?
  marketplaceEligible Boolean?
  createdAt           DateTime          @default(now())
  user                User              @relation(fields: [userId], references: [id])
  assignedOpsUser     OpsUser?          @relation(fields: [assignedOpsUserId], references: [id])
  team                Team?             @relation(fields: [teamId], references: [id])
  quotes              Quote[]
  payment             Payment?
  history             StatusUpdate[]
  notifications       Notification[]
  references          RequestReference[]

  @@index([teamId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([assignedOpsUserId])
}

model RequestReference {
  id        String               @id @default(cuid())
  requestId String
  kind      RequestReferenceKind
  value     String               @db.Text
  createdAt DateTime             @default(now())
  request   Request              @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model Quote {
  id              String      @id @default(cuid())
  requestId       String
  agentId         String
  supplierRef     String
  unitPrice       Decimal     @db.Decimal(14, 2)
  moq             Int
  productCost     Decimal     @db.Decimal(14, 2)
  freightEstimate Decimal     @db.Decimal(14, 2)
  serviceFee      Decimal     @db.Decimal(14, 2)
  totalCost       Decimal     @db.Decimal(14, 2)
  leadTime        String
  isAlternative   Boolean
  status          QuoteStatus @default(sent)
  createdAt       DateTime    @default(now())
  request         Request     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  agent           OpsUser     @relation(fields: [agentId], references: [id])

  @@index([requestId])
  @@index([supplierRef])
}

model Payment {
  id         String          @id @default(cuid())
  requestId  String          @unique
  amount     Decimal         @db.Decimal(14, 2)
  gateway    PaymentGateway
  gatewayRef String          @unique
  status     PaymentStatus
  paidAt     DateTime?
  request    Request         @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model StatusUpdate {
  id        String        @id @default(cuid())
  requestId String
  status    RequestStatus
  note      String
  updatedBy String
  createdAt DateTime      @default(now())
  request   Request       @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([createdAt])
}

model Notification {
  id        String              @id @default(cuid())
  requestId String
  channel   NotificationChannel
  message   String
  createdAt DateTime            @default(now())
  request   Request             @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model Product {
  id                     String              @id @default(cuid())
  slug                   String              @unique
  name                   String
  description            String              @db.Text
  imageUrl               String
  unitPrice              Decimal             @db.Decimal(14, 2)
  currency               String              @default("NGN")
  moq                    Int
  weightKg               Decimal             @db.Decimal(10, 3)
  estimatedDeliveryDays  Int
  availability           ProductAvailability @default(made_to_order)
  status                 ProductStatus       @default(draft)
  verified               Boolean             @default(false)
  featuredOnLanding      Boolean             @default(false)
  landingSort            Int                 @default(0)
  tags                   String[]
  sourceRequestId        String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([status])
  @@index([featuredOnLanding, landingSort])
}

model OpsAuditLog {
  id         String   @id @default(cuid())
  opsUserId  String
  action     String
  entityType String
  entityId   String
  beforeJson String?  @db.Text
  afterJson  String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([opsUserId])
  @@index([entityId])
  @@index([createdAt])
}
