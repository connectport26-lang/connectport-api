generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  personal
  starting_business
  business
}

enum SourceType {
  link
  photo
  text
}

enum RequestChannel {
  sourcing
  catalog
}

enum CancelReason {
  out_of_stock
  customer_request
  other
}

enum Flexibility {
  exact
  flexible
}

enum BudgetScope {
  per_unit
  total
}

enum NeedByKind {
  specific_date
  timeframe
  flexible
}

enum RequestReferenceKind {
  link
  image
}

enum RequestStatus {
  submitted
  quoted
  approved_paid
  procured
  in_transit_china_warehouse
  in_transit_freight
  arrived_nigeria_warehouse
  delivered
  cancelled
}

enum QuoteStatus {
  sent
  accepted
  rejected
}

enum PaymentStatus {
  unpaid
  paid
  failed
  refunded
  refund_pending
}

enum PaymentGateway {
  paystack
  flutterwave
}

enum NotificationChannel {
  whatsapp
  sms
  email
}

enum OpsRole {
  admin
  agent
}

enum FeeMode {
  fixed
  percent
}

enum FindMatchType {
  exact
  alternative
}

enum FindStatus {
  draft
  pending_review
  sent
  rejected
}

enum FindMediaKind {
  image
  video
}

enum CredentialKind {
  requester
  ops
}

enum ProductStatus {
  draft
  verified
  published
  archived
}

enum ProductAvailability {
  in_stock
  made_to_order
  limited
}

model User {
  id          String      @id @default(cuid())
  name        String
  email       String      @unique
  phone       String
  accountType AccountType
  createdAt   DateTime    @default(now())
  credential  Credential?
  requests    Request[]
}

model OpsUser {
  id                  String        @id @default(cuid())
  name                String?
  email               String        @unique
  phone               String?
  /// Legacy enum kept during transition; prefer roleRelation.
  role                OpsRole       @default(agent)
  roleId              String?
  mustChangePassword  Boolean       @default(false)
  profileCompletedAt  DateTime?
  credential          Credential?
  roleRelation        Role?         @relation(fields: [roleId], references: [id])
  assignedRequests    Request[]
  quotes              Quote[]
  finds               ProductFind[] @relation("FindAgent")
  reviewedFinds       ProductFind[] @relation("FindReviewer")
  teamMemberships     TeamMember[]

  @@index([roleId])
}

model Role {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  permissions String[]
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  opsUsers    OpsUser[]
}

model PricingConfig {
  id                 String   @id @default("default")
  shippingRatePerKg  Decimal  @db.Decimal(14, 2)
  agentFeeMode       FeeMode  @default(percent)
  agentFeeValue      Decimal  @db.Decimal(14, 2)
  agentFeeMin        Decimal? @db.Decimal(14, 2)
  agentFeeMax        Decimal? @db.Decimal(14, 2)
  miscMode           FeeMode  @default(fixed)
  miscValue          Decimal  @db.Decimal(14, 2)
  miscMin            Decimal? @db.Decimal(14, 2)
  miscMax            Decimal? @db.Decimal(14, 2)
  profitMode         FeeMode  @default(percent)
  profitValue        Decimal  @db.Decimal(14, 2)
  profitMin          Decimal  @db.Decimal(14, 2)
  profitMax          Decimal  @db.Decimal(14, 2)
  serviceLabel       String   @default("Service & logistics")
  updatedAt          DateTime @updatedAt
}

model ProductFind {
  id            String         @id @default(cuid())
  requestId     String
  agentId       String
  matchType     FindMatchType
  title         String
  notes         String         @db.Text
  supplierCost  Decimal        @db.Decimal(14, 2)
  weightKg      Decimal        @db.Decimal(10, 3)
  moq           Int
  leadTime      String
  status        FindStatus     @default(draft)
  quoteId       String?
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  request       Request        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  agent         OpsUser        @relation("FindAgent", fields: [agentId], references: [id])
  reviewedBy    OpsUser?       @relation("FindReviewer", fields: [reviewedById], references: [id])
  media         ProductFindMedia[]

  @@index([requestId])
  @@index([agentId])
  @@index([reviewedById])
}

model ProductFindMedia {
  id        String        @id @default(cuid())
  findId    String
  kind      FindMediaKind
  url       String
  createdAt DateTime      @default(now())
  find      ProductFind   @relation(fields: [findId], references: [id], onDelete: Cascade)

  @@index([findId])
}

model Team {
  id        String       @id @default(cuid())
  name      String
  createdAt DateTime     @default(now())
  members   TeamMember[]
  requests  Request[]
}

model TeamMember {
  id        String  @id @default(cuid())
  teamId    String
  opsUserId String
  team      Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  opsUser   OpsUser @relation(fields: [opsUserId], references: [id], onDelete: Cascade)

  @@unique([teamId, opsUserId])
  @@index([opsUserId])
}

model Credential {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  kind         CredentialKind
  tokenVersion Int            @default(0)
  disabled     Boolean        @default(false)
  userId       String?        @unique
  opsUserId    String?        @unique
  user         User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  opsUser      OpsUser?       @relation(fields: [opsUserId], references: [id], onDelete: Cascade)
}

model EmailOtp {
  id           String   @id @default(cuid())
  email        String
  purpose      String
  codeHash     String
  payloadJson  String   @db.Text
  attempts     Int      @default(0)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
}

model Request {
  id                  String            @id @default(cuid())
  reference           String            @unique
  userId              String
  channel             RequestChannel    @default(sourcing)
  sourceType          SourceType
  sourceValue         String            @db.Text
  quantity            Int
  budgetMax           Decimal           @db.Decimal(14, 2)
  timeline            String
  qualityNotes        String            @db.Text
  flexibility         Flexibility
  productName         String?
  productDescription  String?           @db.Text
  budgetScope         BudgetScope?
  needByKind          NeedByKind?
  needByDate          DateTime?
  needByTimeframe     String?
  status              RequestStatus     @default(submitted)
  cancelReason        CancelReason?
  cancelNote          String?
  assignedOpsUserId   String?
  teamId              String?
  marketplaceEligible Boolean?
  createdAt           DateTime          @default(now())
  user                User              @relation(fields: [userId], references: [id])
  assignedOpsUser     OpsUser?          @relation(fields: [assignedOpsUserId], references: [id])
  team                Team?             @relation(fields: [teamId], references: [id])
  quotes              Quote[]
  payment             Payment?
  history             StatusUpdate[]
  notifications       Notification[]
  references          RequestReference[]
  finds               ProductFind[]

  @@index([teamId])
  @@index([userId])
  @@index([status])
  @@index([channel])
  @@index([createdAt])
  @@index([assignedOpsUserId])
}

model RequestReference {
  id        String               @id @default(cuid())
  requestId String
  kind      RequestReferenceKind
  value     String               @db.Text
  createdAt DateTime             @default(now())
  request   Request              @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model Quote {
  id              String      @id @default(cuid())
  requestId       String
  agentId         String
  supplierRef     String
  unitPrice       Decimal     @db.Decimal(14, 2)
  moq             Int
  productCost     Decimal     @db.Decimal(14, 2)
  freightEstimate Decimal     @db.Decimal(14, 2)
  serviceFee      Decimal     @db.Decimal(14, 2)
  totalCost       Decimal     @db.Decimal(14, 2)
  leadTime        String
  isAlternative   Boolean
  status          QuoteStatus @default(sent)
  createdAt       DateTime    @default(now())
  request         Request     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  agent           OpsUser     @relation(fields: [agentId], references: [id])

  @@index([requestId])
  @@index([supplierRef])
}

model Payment {
  id          String          @id @default(cuid())
  requestId   String          @unique
  amount      Decimal         @db.Decimal(14, 2)
  gateway     PaymentGateway
  gatewayRef  String          @unique
  status      PaymentStatus
  paidAt      DateTime?
  refundRef   String?
  refundedAt  DateTime?
  request     Request         @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model StatusUpdate {
  id        String        @id @default(cuid())
  requestId String
  status    RequestStatus
  note      String
  updatedBy String
  createdAt DateTime      @default(now())
  request   Request       @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([createdAt])
}

model Notification {
  id        String              @id @default(cuid())
  requestId String
  channel   NotificationChannel
  message   String
  createdAt DateTime            @default(now())
  request   Request             @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model Product {
  id                     String              @id @default(cuid())
  slug                   String              @unique
  name                   String
  description            String              @db.Text
  imageUrl               String
  unitPrice              Decimal             @db.Decimal(14, 2)
  currency               String              @default("NGN")
  moq                    Int
  weightKg               Decimal             @db.Decimal(10, 3)
  estimatedDeliveryDays  Int
  availability           ProductAvailability @default(made_to_order)
  status                 ProductStatus       @default(draft)
  verified               Boolean             @default(false)
  featuredOnLanding      Boolean             @default(false)
  landingSort            Int                 @default(0)
  tags                   String[]
  sourceRequestId        String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([status])
  @@index([featuredOnLanding, landingSort])
}

model OpsAuditLog {
  id         String   @id @default(cuid())
  opsUserId  String
  action     String
  entityType String
  entityId   String
  beforeJson String?  @db.Text
  afterJson  String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([opsUserId])
  @@index([entityId])
  @@index([createdAt])
}
