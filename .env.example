# Homebrew Postgres (peer/trust as your OS user):
# DATABASE_URL="postgresql://YOUR_USER@localhost:5432/connectport?schema=public"
#
# Docker Compose (docker compose up -d):
# DATABASE_URL="postgresql://connectport:connectport@localhost:5433/connectport?schema=public"
#
# Production: always use the pooler URL (Neon pooler / PgBouncer).
# Size connection_limit so replicas × pool < Postgres max_connections.
# Example Neon:
# DATABASE_URL="postgresql://USER:PASS@HOST-pooler/db?pgbouncer=true&connection_limit=5"

DATABASE_URL="postgresql://justeck@localhost:5432/connectport?schema=public"
JWT_SECRET="change-me-to-a-long-random-secret"
# Prefer 1h in production (cookie maxAge follows this)
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3005
CORS_ORIGIN="http://localhost:3000"
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Redis — required in production (rate limits, catalog cache, email queue)
# REDIS_URL="redis://localhost:6379"

# Email (Resend) — required in production for OTP
# RESEND_API_KEY=
# MAIL_FROM="ConnectPort <hello@yourdomain.com>"
# Without Resend, signup returns devCode for local OTP testing.

# Paystack — required in production (no demo pay)
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=
# PAYSTACK_CALLBACK_URL=http://localhost:3000/quotes

# Cloudflare R2 — required in production (no multi-instance disk uploads)
# R2_ACCOUNT_ID=          # optional; useful for docs / dashboards
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=fashion-prod
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_PUBLIC_BASE_URL=https://pub-<hash>.r2.dev

# Observability (optional)
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Cloudflare Turnstile (optional; required after 3 failed logins when set)
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
